{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yata-mpc.local/schemas/upper-plan-v1.schema.json",
  "title": "YATA MPC upper-layer plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schedule_id", "plan_id", "issued_at_utc", "valid_until_utc", "solver_status", "advisory_eligible", "energy_budget_wh", "predicted_remaining_wh_robust", "energy_margin_wh", "deadline_margin_s", "reserve_pct", "segments"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "schedule_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "issued_at_utc": {"type": "string", "format": "date-time"},
    "valid_until_utc": {"type": "string", "format": "date-time"},
    "solver_status": {"type": "string", "enum": ["optimal_finite_grid_milp", "feasible_time_limited_milp_not_proven_optimal"]},
    "advisory_eligible": {"const": true},
    "energy_budget_wh": {"type": "number"},
    "predicted_remaining_wh_robust": {"type": "number"},
    "energy_margin_wh": {"type": "number", "minimum": -1},
    "deadline_margin_s": {"type": "number", "minimum": -1},
    "reserve_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "segments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["start_distance_m", "end_distance_m", "target_speed_kmh", "predicted_net_energy_wh", "predicted_travel_time_s"],
        "properties": {
          "start_distance_m": {"type": "number", "minimum": 0},
          "end_distance_m": {"type": "number", "exclusiveMinimum": 0},
          "target_speed_kmh": {"type": "number", "minimum": 60, "maximum": 78.2},
          "predicted_net_energy_wh": {"type": "number"},
          "predicted_travel_time_s": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
